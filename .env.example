# Copy to a local .env file only. Never commit real values.

# Application
OFFDATA_ENV=development
OFFDATA_APP_URL=http://localhost:3000
OFFDATA_API_URL=http://localhost:8000
OFFDATA_REGION=ap-southeast-1
OFFDATA_TENANT_MODE=single-founder

# Database
DATABASE_URL=postgresql://offdata:CHANGE_ME@localhost:5432/offdata

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=offdata-local
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME

# Authentication — placeholders only
AUTH_SECRET=CHANGE_ME
AUTH_TRUST_HOST=true

# Durable workflow — configure in Phase 3
RESTATE_ENDPOINT=http://localhost:8080

# Model providers — configure in Phase 4
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# CRM — configure in Phase 8
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Email — configure only after outreach approval
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=offdata-local

# Safety and spending
OFFDATA_EXTERNAL_ACTIONS_ENABLED=false
OFFDATA_REAL_CLIENT_DATA_ENABLED=false
OFFDATA_MONTHLY_MODEL_BUDGET_USD=25
