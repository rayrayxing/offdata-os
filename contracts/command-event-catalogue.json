{
  "command_schema": "../schemas/offdata-contract-bundle.schema.json#/$defs/CommandEnvelope",
  "commands": {
    "cancel_engagement": {
      "allowed_actor_types": [
        "founder",
        "user"
      ],
      "approval": "Founder or delegated accountable owner",
      "decision_classes": [
        "DEC-MATERIAL",
        "DEC-IRREVERSIBLE"
      ],
      "failure_events": [
        "workflow_blocked"
      ],
      "idempotency": "required",
      "requirements": [
        "LIFE-009",
        "AUTH-007",
        "DATA-004"
      ],
      "requires_engagement_id": true,
      "success_events": [
        "engagement_cancelled"
      ]
    },
    "create_engagement": {
      "allowed_actor_types": [
        "founder",
        "user",
        "system"
      ],
      "approval": "Founder-approved mandate or delegated creation authority",
      "decision_classes": [
        "DEC-MATERIAL"
      ],
      "failure_events": [
        "workflow_blocked"
      ],
      "idempotency": "recommended",
      "requirements": [
        "DATA-001",
        "DATA-002",
        "AUTH-003"
      ],
      "requires_engagement_id": false,
      "success_events": [
        "engagement_created"
      ]
    },
    "execute_external_action": {
      "allowed_actor_types": [
        "founder",
        "user",
        "integration",
        "system"
      ],
      "approval": "Exact current-version action requires unexpired scoped approval",
      "decision_classes": [
        "DEC-EXTERNAL"
      ],
      "failure_events": [
        "workflow_blocked"
      ],
      "idempotency": "required",
      "requirements": [
        "AUTH-004",
        "LIFE-007",
        "DATA-004"
      ],
      "requires_engagement_id": true,
      "success_events": [
        "external_action_executed"
      ]
    },
    "propose_external_action": {
      "allowed_actor_types": [
        "founder",
        "user",
        "agent",
        "system"
      ],
      "approval": "Proposal only; exact external action must be scoped in approval",
      "decision_classes": [
        "DEC-EXTERNAL"
      ],
      "failure_events": [
        "workflow_blocked"
      ],
      "idempotency": "required",
      "requirements": [
        "AUTH-004",
        "SEC-002"
      ],
      "requires_engagement_id": true,
      "success_events": [
        "external_action_proposed",
        "approval_requested"
      ]
    },
    "propose_transition": {
      "allowed_actor_types": [
        "founder",
        "user",
        "agent",
        "system"
      ],
      "approval": "Deterministic gate; Founder approval where gate is reserved",
      "decision_classes": [
        "DEC-ROUTINE",
        "DEC-MATERIAL"
      ],
      "failure_events": [
        "transition_proposed",
        "transition_rejected",
        "workflow_blocked"
      ],
      "idempotency": "recommended",
      "requirements": [
        "LIFE-002",
        "LIFE-003",
        "LIFE-004",
        "AUTH-003"
      ],
      "requires_engagement_id": true,
      "success_events": [
        "transition_proposed",
        "transition_accepted"
      ]
    },
    "record_agent_output": {
      "allowed_actor_types": [
        "agent",
        "system"
      ],
      "approval": "Output remains proposed until canonical command validation succeeds",
      "decision_classes": [
        "DEC-ROUTINE"
      ],
      "failure_events": [
        "defect_recorded",
        "workflow_blocked"
      ],
      "idempotency": "required",
      "requirements": [
        "AGENT-003",
        "AGENT-004",
        "AGENT-005",
        "DATA-004"
      ],
      "requires_engagement_id": true,
      "success_events": [
        "agent_output_recorded"
      ]
    },
    "record_approval": {
      "allowed_actor_types": [
        "founder",
        "user"
      ],
      "approval": "Approver identity and scope are validated before recording",
      "decision_classes": [
        "DEC-MATERIAL",
        "DEC-EXTERNAL",
        "DEC-COMMERCIAL",
        "DEC-LEGALREG",
        "DEC-IRREVERSIBLE"
      ],
      "failure_events": [
        "workflow_blocked"
      ],
      "idempotency": "required",
      "requirements": [
        "AUTH-003",
        "AUTH-004",
        "AUTH-005",
        "AUTH-007",
        "DATA-004"
      ],
      "requires_engagement_id": true,
      "success_events": [
        "approval_recorded",
        "workflow_resumed"
      ]
    },
    "release_artefact": {
      "allowed_actor_types": [
        "founder",
        "user",
        "system"
      ],
      "approval": "Release gate, scoped approval and immutable baselines required",
      "decision_classes": [
        "DEC-EXTERNAL",
        "DEC-MATERIAL"
      ],
      "failure_events": [
        "defect_recorded",
        "workflow_blocked"
      ],
      "idempotency": "required",
      "requirements": [
        "DELIV-003",
        "DELIV-010",
        "QA-002",
        "AUTH-004"
      ],
      "requires_engagement_id": true,
      "success_events": [
        "artefact_released"
      ]
    },
    "request_approval": {
      "allowed_actor_types": [
        "user",
        "agent",
        "system"
      ],
      "approval": "Creates a request only; does not grant authority",
      "decision_classes": [
        "DEC-MATERIAL",
        "DEC-EXTERNAL",
        "DEC-COMMERCIAL",
        "DEC-LEGALREG",
        "DEC-IRREVERSIBLE"
      ],
      "failure_events": [
        "workflow_blocked"
      ],
      "idempotency": "required",
      "requirements": [
        "AUTH-001",
        "AUTH-009",
        "DATA-004"
      ],
      "requires_engagement_id": true,
      "success_events": [
        "approval_requested"
      ]
    },
    "update_mandate": {
      "allowed_actor_types": [
        "founder",
        "user",
        "agent"
      ],
      "approval": "Required when scope, intended use, deadline, fee or commitment changes",
      "decision_classes": [
        "DEC-ROUTINE",
        "DEC-MATERIAL"
      ],
      "failure_events": [
        "workflow_blocked"
      ],
      "idempotency": "recommended",
      "requirements": [
        "OUT-002",
        "AUTH-003",
        "DATA-003"
      ],
      "requires_engagement_id": true,
      "success_events": [
        "mandate_updated"
      ]
    }
  },
  "event_schema": "../schemas/offdata-contract-bundle.schema.json#/$defs/DomainEvent",
  "events": {
    "agent_output_recorded": {
      "aggregate_change": true,
      "replay_required": true
    },
    "approval_recorded": {
      "aggregate_change": true,
      "replay_required": true
    },
    "approval_requested": {
      "aggregate_change": true,
      "replay_required": true
    },
    "artefact_released": {
      "aggregate_change": true,
      "non_repeatable_side_effect": true,
      "replay_required": true
    },
    "defect_recorded": {
      "aggregate_change": true,
      "replay_required": true
    },
    "engagement_cancelled": {
      "aggregate_change": true,
      "replay_required": true
    },
    "engagement_created": {
      "aggregate_change": true,
      "replay_required": true
    },
    "external_action_executed": {
      "aggregate_change": true,
      "non_repeatable_side_effect": true,
      "replay_required": true
    },
    "external_action_proposed": {
      "aggregate_change": true,
      "replay_required": true
    },
    "mandate_updated": {
      "aggregate_change": true,
      "replay_required": true
    },
    "transition_accepted": {
      "aggregate_change": true,
      "replay_required": true
    },
    "transition_proposed": {
      "aggregate_change": false,
      "replay_required": true
    },
    "transition_rejected": {
      "aggregate_change": false,
      "replay_required": true
    },
    "workflow_blocked": {
      "aggregate_change": true,
      "replay_required": true
    },
    "workflow_resumed": {
      "aggregate_change": true,
      "replay_required": true
    }
  },
  "version": "1.0.0"
}
