{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offdata.local/schemas/codex-phase0-issue.schema.json",
  "title": "offdata PCR-09 first Codex issue rewrite",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "phase_id",
    "title",
    "contract_id",
    "repository",
    "canonical_branch",
    "status",
    "target_issue",
    "supersession",
    "authority",
    "presentation",
    "rewrite_rules",
    "boundaries",
    "generated_from",
    "handoff_source",
    "handoff_snapshot",
    "readiness_snapshot",
    "generated_issue"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "phase_id": {
      "const": "PCR-09"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "const": "rayrayxing/offdata-os"
    },
    "canonical_branch": {
      "const": "main"
    },
    "status": {
      "const": "canonical_issue_prepared"
    },
    "target_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "original_title",
        "original_body_sha256",
        "rewritten_title",
        "canonical_body_path",
        "machine_contract_path",
        "preserve_assignees",
        "preserve_open_state"
      ],
      "properties": {
        "number": {
          "const": 1
        },
        "original_title": {
          "type": "string",
          "minLength": 1
        },
        "original_body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rewritten_title": {
          "type": "string",
          "minLength": 20
        },
        "canonical_body_path": {
          "const": "handoff/codex-phase0-issue.md"
        },
        "machine_contract_path": {
          "const": "contracts/codex-phase0-issue.json"
        },
        "preserve_assignees": {
          "const": true
        },
        "preserve_open_state": {
          "const": true
        }
      }
    },
    "supersession": {
      "type": "object",
      "required": [
        "issue_numbers",
        "canonical_issue_number",
        "treatment",
        "preserve_history",
        "snapshots"
      ],
      "properties": {
        "issue_numbers": {
          "const": [
            2
          ]
        },
        "canonical_issue_number": {
          "const": 1
        },
        "treatment": {
          "const": "close_as_duplicate_after_target_rewrite"
        },
        "preserve_history": {
          "const": true
        },
        "snapshots": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "authority": {
      "type": "object"
    },
    "presentation": {
      "type": "object"
    },
    "rewrite_rules": {
      "type": "object"
    },
    "boundaries": {
      "type": "object"
    },
    "generated_from": {
      "const": "configs/codex-phase0-issue.yaml"
    },
    "handoff_source": {
      "const": "configs/codex-handoff.yaml"
    },
    "handoff_snapshot": {
      "type": "object",
      "required": [
        "target",
        "read_order",
        "prerequisite_records",
        "task_graph",
        "execution",
        "prohibited_actions",
        "stop_conditions",
        "activation_conditions",
        "completion_report_fields",
        "boundaries"
      ]
    },
    "readiness_snapshot": {
      "type": "object",
      "required": [
        "task_count",
        "read_order_count",
        "prerequisite_record_count",
        "required_command_count",
        "prohibited_action_count",
        "stop_condition_count",
        "activation_condition_count",
        "completion_report_field_count",
        "superseded_issue_count",
        "checks",
        "local_prerequisites_passed",
        "github_issue_sync_verified",
        "codex_start_authorized",
        "phase1_authorized"
      ],
      "properties": {
        "task_count": {
          "const": 4
        },
        "activation_condition_count": {
          "const": 10
        },
        "superseded_issue_count": {
          "const": 1
        },
        "local_prerequisites_passed": {
          "const": true
        },
        "github_issue_sync_verified": {
          "const": false
        },
        "codex_start_authorized": {
          "const": false
        },
        "phase1_authorized": {
          "const": false
        }
      }
    },
    "generated_issue": {
      "type": "object",
      "required": [
        "title",
        "body_path",
        "body_sha256",
        "body_character_count",
        "body_line_count",
        "github_issue_sync_verified"
      ],
      "properties": {
        "body_path": {
          "const": "handoff/codex-phase0-issue.md"
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "body_character_count": {
          "type": "integer",
          "minimum": 5000,
          "maximum": 65536
        },
        "body_line_count": {
          "type": "integer",
          "minimum": 100
        },
        "github_issue_sync_verified": {
          "const": false
        }
      }
    }
  }
}
