{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offdata.local/schemas/workstream6-final-reconciliation.schema.json",
  "title": "Workstream 6 final reconciliation baseline contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "workstream_id",
    "work_package_id",
    "contract_id",
    "title",
    "repository",
    "canonical_branch",
    "baseline",
    "authority",
    "prior_components",
    "prior_component_checks",
    "live_issue_snapshot",
    "branch_inventory_snapshot",
    "defects",
    "workstream_sequence",
    "completion_rule",
    "manual_gates",
    "boundaries",
    "rollback",
    "generated_from",
    "status",
    "defect_summary",
    "prior_component_summary",
    "durable_release"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "workstream_id": {"const": "WORKSTREAM-6"},
    "work_package_id": {"const": "WS6.0"},
    "contract_id": {"const": "WORKSTREAM6-FINAL-RECONCILIATION"},
    "repository": {"const": "rayrayxing/offdata-os"},
    "canonical_branch": {"const": "main"},
    "status": {"const": "baseline_locked_repairs_pending"},
    "generated_from": {"const": "configs/workstream6-final-reconciliation.yaml"},
    "baseline": {
      "type": "object",
      "required": ["captured_at", "timezone", "main_sha", "workstream5_pr", "workstream5_head_sha", "workstream5_tested_merge_ref", "workstream5_run_id", "runtime_tests_passed", "coverage_percent", "unresolved_reference_count"],
      "properties": {
        "main_sha": {"pattern": "^[0-9a-f]{40}$"},
        "workstream5_head_sha": {"pattern": "^[0-9a-f]{40}$"},
        "workstream5_tested_merge_ref": {"pattern": "^[0-9a-f]{40}$"},
        "workstream5_artifact_sha256": {"pattern": "^[0-9a-f]{64}$"},
        "unresolved_reference_count": {"const": 0}
      }
    },
    "prior_components": {
      "type": "array",
      "minItems": 19,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "title", "state", "required"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "title": {"type": "string", "minLength": 3},
          "state": {"enum": ["complete_integrated", "repository_complete_manual_gates_pending"]},
          "required": {"const": true}
        }
      }
    },
    "prior_component_checks": {
      "type": "object",
      "minProperties": 12,
      "additionalProperties": {"const": true}
    },
    "branch_inventory_snapshot": {
      "type": "object",
      "required": ["captured_before_ws6_branch_creation", "branch_count", "branches", "cleanup_complete", "codex_phase0_branch_present"],
      "properties": {
        "captured_before_ws6_branch_creation": {"const": true},
        "branch_count": {"const": 28},
        "branches": {"type": "array", "minItems": 28, "maxItems": 28, "items": {"type": "string"}, "uniqueItems": true},
        "cleanup_complete": {"const": false},
        "codex_phase0_branch_present": {"const": false}
      }
    },
    "defects": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "kind", "title", "evidence", "affected_authority", "repair_files", "validation", "rollback", "owner", "target_work_package", "status"],
        "properties": {
          "id": {"pattern": "^WS6-(BLOCK|CONSIST|QUALITY|CODEXPREP)-[0-9]{3}$"},
          "severity": {"enum": ["blocking", "important", "planned"]},
          "kind": {"enum": ["defect", "hygiene", "evidence", "scope_gap"]},
          "title": {"type": "string", "minLength": 10},
          "evidence": {"type": "string", "minLength": 10},
          "affected_authority": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "repair_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "validation": {"type": "string", "minLength": 10},
          "rollback": {"type": "string", "minLength": 10},
          "owner": {"type": "string", "minLength": 3},
          "target_work_package": {"type": "string", "minLength": 4},
          "status": {"const": "open"}
        }
      }
    },
    "manual_gates": {"type": "object", "minProperties": 7, "additionalProperties": {"const": false}},
    "boundaries": {
      "type": "object",
      "required": ["founder_accountability_preserved", "codex_start_authorized", "phase0_implementation_authorized", "phase0_merge_authorized", "phase1_authorized", "runtime_activation_authorized", "real_client_data_enabled", "external_actions_authorized", "paid_services_authorized", "autonomous_merge_authorized"],
      "properties": {"founder_accountability_preserved": {"const": true}},
      "additionalProperties": {"type": "boolean"}
    },
    "defect_summary": {
      "type": "object",
      "required": ["total", "by_severity", "by_kind", "by_status", "by_work_package"],
      "properties": {"total": {"const": 28}}
    },
    "prior_component_summary": {
      "type": "object",
      "required": ["total", "complete_integrated", "repository_complete_manual_gates_pending", "all_required"],
      "properties": {
        "total": {"const": 19},
        "complete_integrated": {"const": 17},
        "repository_complete_manual_gates_pending": {"const": 2},
        "all_required": {"const": true}
      }
    }
  }
}
