{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offdata.local/schemas/initial-operating-controls.schema.json",
  "title": "offdata PCR-08 initial operating-control configuration",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "phase_id",
    "contract_id",
    "repository",
    "canonical_branch",
    "status",
    "operating_context",
    "authority_matrix",
    "control_domains",
    "operating_gates",
    "control_switches",
    "cost_and_usage",
    "incident_routing",
    "retention_and_recovery",
    "provider_and_processor",
    "operating_cadences",
    "exception_policy",
    "control_evidence",
    "activation_conditions",
    "boundaries",
    "generated_from",
    "readiness_snapshot"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "phase_id": {"const": "PCR-08"},
    "contract_id": {"type": "string", "minLength": 1},
    "repository": {"const": "rayrayxing/offdata-os"},
    "canonical_branch": {"const": "main"},
    "status": {"const": "initial_configuration_only"},
    "operating_context": {
      "type": "object",
      "required": ["operator_model", "operating_mode", "managed_region", "permitted_data_classes", "canonical_write_mode", "network_default"],
      "additionalProperties": true
    },
    "authority_matrix": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["decision_class", "execution_mode", "accountable_owner", "delegation_allowed", "qualified_specialist_required", "external_execution_enabled"]
      }
    },
    "control_domains": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["domain_id", "title", "accountable_owner", "independent_review_required", "enforcement_mode", "activation_state", "security_control_ids"],
        "properties": {
          "security_control_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "operating_gates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": ["gate_id", "subject", "authorized", "required_conditions"],
        "properties": {
          "authorized": {"const": false},
          "required_conditions": {"type": "array", "minItems": 2, "items": {"type": "string"}}
        }
      }
    },
    "control_switches": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["switch_id", "scope", "initial_state", "fail_mode", "reset_authority", "audit_event_required"],
        "properties": {
          "initial_state": {"const": "deny"},
          "fail_mode": {"const": "fail_closed"},
          "reset_authority": {"const": "Founder"},
          "audit_event_required": {"const": true}
        }
      }
    },
    "cost_and_usage": {
      "type": "object",
      "required": ["currency", "paid_provider_spend_hard_cap", "purchases_authorized", "required_budget_profiles"],
      "properties": {
        "currency": {"const": "USD"},
        "paid_provider_spend_hard_cap": {"const": 0},
        "purchases_authorized": {"const": false}
      }
    },
    "incident_routing": {
      "type": "object",
      "required": ["agents_may_assist", "agents_may_close_material_incidents", "preserve_evidence_before_repair", "implicated_actor_may_be_sole_reviewer", "severities", "playbook_ids"]
    },
    "retention_and_recovery": {
      "type": "object",
      "required": ["retention_policy_ids", "legal_hold_overrides_deletion", "deletion_is_autonomous", "founder_approval_required_for_deletion", "deletion_verification_required", "derived_data_deletion_required", "backup_restore_evidence_status", "recovery_objectives_status"]
    },
    "provider_and_processor": {
      "type": "object",
      "required": ["unregistered_processor_default", "approved_real_client_processor_count", "oauth_authorized", "provider_gateway_authorized", "provider_training_allowed", "credential_values_permitted", "paid_service_activation_authorized"]
    },
    "operating_cadences": {
      "type": "array",
      "minItems": 7,
      "items": {"type": "object", "required": ["cadence_id", "cadence", "enabled_now", "activities"]}
    },
    "exception_policy": {
      "type": "object",
      "required": ["silent_waivers_permitted", "exact_scope_required", "expiry_required", "compensating_controls_required", "independent_review_required", "founder_approval_required", "non_waivable_boundaries"]
    },
    "control_evidence": {
      "type": "object",
      "required": ["chat_first_configuration_current", "hosted_control_evidence_complete", "operating_environment_evidence_complete", "production_evidence_complete", "evidence_expiry_enforced", "evidence_must_match_environment_and_region"]
    },
    "activation_conditions": {"type": "array", "minItems": 9, "items": {"type": "string"}, "uniqueItems": true},
    "boundaries": {
      "type": "object",
      "required": ["initial_operating_controls_activation_authorized", "codex_start_authorized", "runtime_activation_authorized", "hermes_activation_authorized", "northstar_implementation_authorized", "real_client_data_enabled", "external_actions_authorized", "paid_services_authorized", "production_deployment_authorized", "autonomous_merge_authorized", "founder_accountability_preserved"]
    },
    "generated_from": {"const": "configs/initial-operating-controls.yaml"},
    "readiness_snapshot": {
      "type": "object",
      "required": ["decision_class_count", "control_domain_count", "security_control_count", "mandatory_real_client_control_count", "operating_gate_count", "control_switch_count", "incident_playbook_count", "retention_policy_count", "budget_profile_count", "idempotency_required_command_count", "approved_real_client_processor_count", "hosted_control_requirement_count", "operating_cadence_count", "checks", "local_prerequisites_passed", "hosted_control_evidence_complete", "operating_environment_evidence_complete", "production_evidence_complete", "initial_operating_controls_activation_authorized", "codex_start_authorized", "runtime_activation_authorized", "hermes_activation_authorized", "northstar_implementation_authorized"]
    }
  }
}
