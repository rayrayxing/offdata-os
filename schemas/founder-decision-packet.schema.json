{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offdata.com/schemas/founder-decision-packet.schema.json",
  "title": "Offdata Founder Decision Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_required",
    "latest_responsible_date",
    "reserved_reason",
    "facts",
    "evidence_gaps",
    "assumptions",
    "options",
    "recommendation",
    "resulting_action",
    "fallback"
  ],
  "properties": {
    "decision_required": {"type": "string", "minLength": 1},
    "latest_responsible_date": {"type": "string", "format": "date-time"},
    "decision_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "DEC-MATERIAL",
          "DEC-EXTERNAL",
          "DEC-COMMERCIAL",
          "DEC-LEGALREG",
          "DEC-IRREVERSIBLE"
        ]
      }
    },
    "reserved_reason": {"type": "string", "minLength": 1},
    "consequence_of_delay": {"type": "string"},
    "facts": {"type": "array", "items": {"type": "string"}},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option", "consequences"],
        "properties": {
          "option": {"type": "string"},
          "consequences": {"type": "object"},
          "risks": {"type": "array", "items": {"type": "string"}},
          "conditions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "recommendation": {"type": "string", "minLength": 1},
    "rationale": {"type": "array", "items": {"type": "string"}},
    "resulting_action": {"type": "string", "minLength": 1},
    "fallback": {"type": "string", "minLength": 1}
  }
}
