{
  "$defs": {
    "case": {
      "additionalProperties": false,
      "properties": {
        "acceptance_class": {
          "enum": [
            "positive",
            "failure",
            "safety",
            "retry"
          ]
        },
        "assertion_count": {
          "minimum": 3,
          "type": "integer"
        },
        "case_id": {
          "pattern": "^DX-[A-Z0-9-]+-(POSITIVE|FAILURE|SAFETY|RETRY)-001$",
          "type": "string"
        },
        "expected_exit_code": {
          "enum": [
            0,
            2,
            3,
            4,
            5,
            6,
            7,
            8,
            9,
            10,
            130
          ],
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "acceptance_class",
        "expected_exit_code",
        "assertion_count"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "acceptance_case_count": {
      "const": 60
    },
    "closed_defects": {
      "const": [
        "WS6-QUALITY-002"
      ]
    },
    "command_count": {
      "const": 15
    },
    "commands": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "acceptance_cases": {
            "items": {
              "$ref": "#/$defs/case"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "criteria": {
            "minItems": 2,
            "type": "array",
            "uniqueItems": true
          },
          "exits": {
            "items": {
              "enum": [
                0,
                2,
                3,
                4,
                5,
                6,
                7,
                8,
                9,
                10,
                130
              ],
              "type": "integer"
            },
            "minItems": 2,
            "type": "array",
            "uniqueItems": true
          },
          "flags": {
            "type": "array"
          },
          "implementation_status": {
            "const": "specified_not_implemented"
          },
          "name": {
            "type": "string"
          },
          "retry": {
            "properties": {
              "maximum_attempts": {
                "maximum": 20,
                "minimum": 1,
                "type": "integer"
              },
              "state_recheck_required": {
                "const": true
              }
            },
            "required": [
              "maximum_attempts",
              "backoff_seconds",
              "retryable_conditions",
              "non_retryable_conditions",
              "state_recheck_required"
            ],
            "type": "object"
          },
          "task": {
            "enum": [
              "P0.2",
              "P0.3",
              "P0.4"
            ]
          }
        },
        "required": [
          "name",
          "task",
          "component",
          "category",
          "mutation",
          "idempotency",
          "confirmation",
          "network",
          "flags",
          "exits",
          "retry",
          "criteria",
          "acceptance_cases",
          "implementation_status"
        ],
        "type": "object"
      },
      "maxItems": 15,
      "minItems": 15,
      "type": "array"
    },
    "exit_code_count": {
      "const": 11
    },
    "exit_codes": {
      "maxItems": 11,
      "minItems": 11,
      "type": "array"
    },
    "global_flag_count": {
      "const": 9
    },
    "global_flags": {
      "maxItems": 9,
      "minItems": 9,
      "type": "array"
    },
    "implementation_evidence": {
      "additionalProperties": false,
      "properties": {
        "satisfied_command_count": {
          "const": 0
        },
        "status": {
          "const": "not_available_pre_implementation"
        }
      },
      "required": [
        "satisfied_command_count",
        "status"
      ],
      "type": "object"
    },
    "remaining_blocking_defects": {
      "const": [
        "WS6-BLOCK-006"
      ]
    },
    "remaining_preparation_defects": {
      "const": [
        "WS6-CODEXPREP-002"
      ]
    },
    "test_registration": {
      "additionalProperties": false,
      "properties": {
        "executable_test_count": {
          "const": 0
        },
        "planned_case_count": {
          "const": 60
        },
        "registered_case_count": {
          "const": 0
        },
        "separate_registration_defect": {
          "const": "WS6-CODEXPREP-002"
        }
      },
      "required": [
        "planned_case_count",
        "registered_case_count",
        "executable_test_count",
        "separate_registration_defect"
      ],
      "type": "object"
    },
    "work_package_id": {
      "const": "WS6.10"
    }
  },
  "required": [
    "work_package_id",
    "predecessor",
    "surface",
    "global_flags",
    "exit_codes",
    "shared_contracts",
    "commands",
    "command_count",
    "acceptance_case_count",
    "test_registration",
    "implementation_evidence",
    "closed_defects",
    "remaining_blocking_defects",
    "remaining_preparation_defects",
    "completion",
    "boundaries"
  ],
  "type": "object"
}
