{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offdata.com/schemas/codex-handoff.schema.json",
  "title": "offdata Codex Phase 0 handoff — WS6.1 reconciled",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "phase_id",
    "reconciled_by",
    "handoff_id",
    "repository",
    "canonical_branch",
    "target",
    "authority",
    "read_order",
    "prerequisite_records",
    "existing_assets",
    "task_graph",
    "execution",
    "prohibited_actions",
    "stop_conditions",
    "activation_conditions",
    "completion_report_fields",
    "boundaries",
    "generated_from",
    "readiness_snapshot"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "phase_id": {"const": "PCR-04"},
    "reconciled_by": {"const": "WS6.1"},
    "handoff_id": {"const": "CODEX-PHASE0-HANDOFF-2026-08-06"},
    "repository": {"const": "rayrayxing/offdata-os"},
    "canonical_branch": {"const": "main"},
    "generated_from": {"const": "configs/codex-handoff.yaml"},
    "target": {
      "type": "object",
      "required": [
        "phase_number",
        "phase_name",
        "backlog_document",
        "phase_gate",
        "start_requires_explicit_founder_approval",
        "start_requires_valid_launch_permit",
        "start_requires_final_workstream6_reconciliation",
        "maximum_authorised_phase",
        "next_phase_is_prohibited"
      ],
      "properties": {
        "phase_number": {"const": 0},
        "phase_name": {"const": "Controlled project foundation"},
        "backlog_document": {"const": "docs/11-BUILD-BACKLOG.md"},
        "phase_gate": {"type": "string", "minLength": 10},
        "start_requires_explicit_founder_approval": {"const": true},
        "start_requires_valid_launch_permit": {"const": true},
        "start_requires_final_workstream6_reconciliation": {"const": true},
        "maximum_authorised_phase": {"const": 0},
        "next_phase_is_prohibited": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "controlling_instruction",
        "machine_execution_contract",
        "current_launch_control",
        "current_workstream6_reconciliation",
        "final_workstream6_gate",
        "precedence",
        "historical_repositories_are_non_controlling"
      ],
      "properties": {
        "controlling_instruction": {"const": "AGENTS.md"},
        "machine_execution_contract": {"const": "handoff/codex-phase0-handoff.json"},
        "current_launch_control": {"const": "contracts/codex-phase0-launch-control.json"},
        "current_workstream6_reconciliation": {"const": "contracts/workstream6-handoff-reconciliation.json"},
        "final_workstream6_gate": {"const": "scripts/require_workstream6_final_reconciliation.py"}
      }
    },
    "read_order": {
      "type": "array",
      "minItems": 45,
      "maxItems": 45,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "prerequisite_records": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "validator", "required_status"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "path": {"type": "string", "minLength": 3},
          "validator": {"type": "string", "pattern": "^scripts/validate_.*\\.py$"},
          "required_status": {"type": "string", "minLength": 3}
        }
      }
    },
    "task_graph": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "dependencies", "deliverables", "acceptance"],
        "properties": {
          "id": {"enum": ["P0.1", "P0.2", "P0.3", "P0.4"]},
          "title": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "deliverables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "acceptance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_name",
        "pull_request_mode",
        "merge_requires_founder_approval",
        "launch_permit_required",
        "launch_permit_path",
        "final_workstream6_gate_command",
        "implementation_method",
        "required_commands"
      ],
      "properties": {
        "branch_name": {"const": "codex/phase-0-foundation"},
        "pull_request_mode": {"const": "draft"},
        "merge_requires_founder_approval": {"const": true},
        "launch_permit_required": {"const": true},
        "launch_permit_path": {"const": ".local/codex-phase0-launch/permit.json"},
        "final_workstream6_gate_command": {"const": "python scripts/require_workstream6_final_reconciliation.py"},
        "implementation_method": {"type": "array", "minItems": 8, "items": {"type": "string"}},
        "required_commands": {
          "type": "array",
          "minItems": 49,
          "maxItems": 49,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "activation_conditions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "prohibited_actions": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "minItems": 12, "uniqueItems": true, "items": {"type": "string"}},
    "completion_report_fields": {"type": "array", "minItems": 14, "uniqueItems": true, "items": {"type": "string"}},
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_client_data_enabled",
        "external_actions_authorised",
        "paid_services_authorised",
        "production_deployment_authorised",
        "autonomous_merge_authorised",
        "phase0_implementation_authorised",
        "phase0_merge_authorised",
        "phase1_authorised",
        "runtime_activation_authorised",
        "hermes_activation_authorised",
        "northstar_implementation_authorised",
        "launch_permit_issued",
        "final_workstream6_gate_complete",
        "original_methodology_binaries_committed",
        "founder_accountability_preserved"
      ],
      "properties": {
        "real_client_data_enabled": {"const": false},
        "external_actions_authorised": {"const": false},
        "paid_services_authorised": {"const": false},
        "production_deployment_authorised": {"const": false},
        "autonomous_merge_authorised": {"const": false},
        "phase0_implementation_authorised": {"const": false},
        "phase0_merge_authorised": {"const": false},
        "phase1_authorised": {"const": false},
        "runtime_activation_authorised": {"const": false},
        "hermes_activation_authorised": {"const": false},
        "northstar_implementation_authorised": {"const": false},
        "launch_permit_issued": {"const": false},
        "final_workstream6_gate_complete": {"const": true},
        "original_methodology_binaries_committed": {"const": false},
        "founder_accountability_preserved": {"const": true}
      }
    },
    "readiness_snapshot": {
      "type": "object",
      "required": [
        "canonical_release",
        "referential_integrity",
        "repository_governance",
        "runtime_adapters",
        "hermes_compatibility",
        "northstar_blueprint",
        "initial_operating_controls",
        "pre_codex_readiness",
        "workstream4_readiness",
        "workstream5_launch_control",
        "workstream6_baseline_lock",
        "workstream6_handoff_reconciliation",
        "local_prerequisites_passed",
        "final_workstream6_gate_complete",
        "hosted_controls_verified",
        "clean_macos_environment_verified",
        "explicit_founder_phase0_approval_received",
        "launch_permit_issued",
        "codex_start_authorized",
        "activation_status",
        "activation_blockers"
      ],
      "properties": {
        "local_prerequisites_passed": {"const": true},
        "final_workstream6_gate_complete": {"const": true},
        "hosted_controls_verified": {"const": false},
        "clean_macos_environment_verified": {"const": false},
        "explicit_founder_phase0_approval_received": {"const": false},
        "launch_permit_issued": {"const": false},
        "codex_start_authorized": {"const": false},
        "activation_status": {"type": "object", "minProperties": 15},
        "activation_blockers": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true}
      }
    }
  }
}
