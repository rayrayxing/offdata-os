{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offdata.com/schemas/agent-envelope.schema.json",
  "title": "Offdata Agent Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "record_changes",
    "assumptions",
    "evidence_gaps",
    "escalation"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "partial", "blocked", "failed"]
    },
    "summary": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "record_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_type", "operation", "payload"],
        "properties": {
          "record_type": {"type": "string"},
          "record_id": {"type": ["string", "null"]},
          "operation": {
            "type": "string",
            "enum": ["propose_create", "propose_update", "propose_archive"]
          },
          "payload": {"type": "object"},
          "reason": {"type": "string"}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "evidence_gaps": {"type": "array", "items": {"type": "string"}},
    "contradicting_evidence": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "quality_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "result"],
        "properties": {
          "check_id": {"type": "string"},
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "not_applicable"]
          },
          "details": {"type": "string"}
        }
      },
      "default": []
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {"type": "boolean"},
        "decision_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "DEC-ROUTINE",
              "DEC-MATERIAL",
              "DEC-EXTERNAL",
              "DEC-COMMERCIAL",
              "DEC-LEGALREG",
              "DEC-IRREVERSIBLE"
            ]
          }
        },
        "reason": {"type": "string"},
        "latest_responsible_date": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "notes_for_next_actor": {"type": "string", "default": ""},
    "usage": {
      "type": "object",
      "properties": {
        "model": {"type": "string"},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "estimated_cost": {"type": "number", "minimum": 0},
        "currency": {"type": "string"}
      }
    }
  }
}
