{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offdata.dev/schemas/hermes-compatibility.schema.json",
  "title": "Offdata Hermes compatibility pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "contract_id",
    "repository",
    "canonical_branch",
    "upstream",
    "adoption",
    "compatibility_surfaces",
    "skill_policy",
    "worker_adapter",
    "tool_mapping",
    "verification",
    "activation_conditions",
    "boundaries",
    "generated_from",
    "readiness_snapshot"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "phase_id": {"const": "PCR-06"},
    "contract_id": {"type": "string", "minLength": 1},
    "repository": {"const": "rayrayxing/offdata-os"},
    "canonical_branch": {"const": "main"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "documentation", "assessed_release", "assessed_tag", "assessed_commit", "assessment_date", "update_policy"],
      "properties": {
        "repository": {"const": "NousResearch/hermes-agent"},
        "documentation": {"type": "string", "format": "uri"},
        "assessed_release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "assessed_tag": {"type": "string", "minLength": 1},
        "assessed_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "assessment_date": {"type": "string", "format": "date"},
        "update_policy": {"const": "pinned_review_required"}
      }
    },
    "adoption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "installation_authorized", "runtime_activation_authorized", "production_use_authorized", "provider_gateway_authorized", "oauth_authorized", "messaging_channels_authorized", "background_delegation_authorized", "autonomous_skill_writes_authorized", "autonomous_memory_writes_authorized", "yolo_mode_authorized", "real_client_data_enabled"],
      "properties": {
        "status": {"const": "compatibility_pack_only"},
        "installation_authorized": {"const": false},
        "runtime_activation_authorized": {"const": false},
        "production_use_authorized": {"const": false},
        "provider_gateway_authorized": {"const": false},
        "oauth_authorized": {"const": false},
        "messaging_channels_authorized": {"const": false},
        "background_delegation_authorized": {"const": false},
        "autonomous_skill_writes_authorized": {"const": false},
        "autonomous_memory_writes_authorized": {"const": false},
        "yolo_mode_authorized": {"const": false},
        "real_client_data_enabled": {"const": false}
      }
    },
    "compatibility_surfaces": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface_id", "upstream_features", "offdata_mode", "compatibility", "required_controls"],
        "properties": {
          "surface_id": {"type": "string", "pattern": "^HERMES-SURFACE-[A-Z]+$"},
          "upstream_features": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "offdata_mode": {"type": "string", "minLength": 1},
          "compatibility": {"enum": ["compatible_with_adapter", "compatible_with_restrictions", "incompatible_for_canonical_state"]},
          "required_controls": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "skill_policy": {"type": "object"},
    "worker_adapter": {"type": "object"},
    "tool_mapping": {"type": "array", "minItems": 5, "items": {"type": "object"}},
    "verification": {"type": "object"},
    "activation_conditions": {"type": "array", "minItems": 9, "items": {"type": "string"}, "uniqueItems": true},
    "boundaries": {"type": "object"},
    "generated_from": {"const": "configs/hermes-compatibility.yaml"},
    "readiness_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pcr05_adapter_present", "pcr05_adapter_activation_authorized", "pcr05_runtime_activation_authorized", "pcr04_codex_start_authorized", "repository_skill_count", "skill_files_valid", "local_prerequisites_passed", "hermes_activation_authorized"],
      "properties": {
        "pcr05_adapter_present": {"const": true},
        "pcr05_adapter_activation_authorized": {"const": false},
        "pcr05_runtime_activation_authorized": {"const": false},
        "pcr04_codex_start_authorized": {"const": false},
        "repository_skill_count": {"type": "integer", "minimum": 1},
        "skill_files_valid": {"const": true},
        "local_prerequisites_passed": {"const": true},
        "hermes_activation_authorized": {"const": false}
      }
    }
  }
}
